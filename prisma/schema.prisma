// Roava — a personal travel map, place log, and trip planner.
//
// Postgres, so the same engine runs locally (via PGlite, see
// scripts/dev-postgres.ts) and in production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) tables — required shape for @auth/prisma-adapter ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A person using Roava. Name and email are optional because that is the shape
/// the Auth.js adapter writes — a provider is not obliged to give us either.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  homeCity      String?
  createdAt     DateTime  @default(now())

  /// Lowercase handle. Null until chosen — a user without one simply has no
  /// public profile and cannot be followed.
  username      String?   @unique
  bio           String?
  /// Where they are headed next, in their own words — "Patagonia, if the
  /// flights ever behave". Prose rather than a list of places: a wishlist is
  /// built out of saved places, and those are private.
  wantsToGo     String?
  /// How they travel — "slowly, one city at a time", "trains only". The thing
  /// you actually want to know about somebody before following them, and the
  /// thing no count of countries tells you.
  travelStyle   String?
  /// Whether the places you have been are shown to people who follow you.
  ///
  /// Off until somebody says otherwise. Saved places are the most private
  /// thing in this app — a wishlist, a rating, a note about a restaurant, and
  /// in the "lived" case an address history — so sharing them is a thing you
  /// do rather than a thing that happens to you.
  ///
  /// What this covers is deliberately narrower than "my places": only status
  /// "visited", never "lived" and never "wishlist". Where somebody has lived
  /// is not a recommendation and no switch should be able to publish it;
  /// somewhere they hope to go is not one either.
  sharesVisited Boolean @default(false)
  /// Set once someone has been through (or skipped) the welcome. Null means
  /// they have never seen it, which is what sends them there.
  onboardedAt   DateTime?
  /// When somebody put the first-steps list away.
  ///
  /// The steps themselves are not stored: they are counted from what actually
  /// exists, so the list cannot claim you have made a trip when you have not,
  /// and cannot be left stuck by a write that half-failed. The only thing worth
  /// remembering is that you did not want to see it any more.
  stepsHiddenAt DateTime?

  accounts       Account[]
  sessions       Session[]
  places         Place[]
  trips          Trip[]
  categories     Category[]
  categoryEdits  CategoryOverride[]
  placeShares    PlaceShare[]
  aiDrafts       AiDraft[]
  wants          TripWant[]
  memories       Memory[]
  photos         Photo[]
  blocking       Block[]            @relation("blocker")
  blockedBy      Block[]            @relation("blocked")
  reportsMade    Report[]           @relation("reporter")
  reportsAbout   Report[]           @relation("reported")
  collaborations TripCollaborator[]
  travelArrivals TravelArrival[]
  /// People this user follows
  following      Follow[]           @relation("follower")
  /// People who follow this user
  followers      Follow[]           @relation("following")
  notifications  Notification[]     @relation("recipient")
  caused         Notification[]     @relation("actor")
}

/// Something someone else did that you would want to know about.
///
/// In-app only: there is no mail provider wired up, and a notification you see
/// next time you open the app is worth more than an email nobody set up.
model Notification {
  id        String    @id @default(cuid())
  /// Who should see it
  userId    String
  /// "follow" or "copy"
  kind      String
  /// Who did the thing
  actorId   String?
  /// The trip involved, for a copy
  tripId    String?
  /// Denormalised so the notification still reads correctly after the trip is
  /// renamed or deleted.
  tripTitle String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// One person deciding they do not want anything to do with another.
///
/// Blocking is mutual in effect even though it is one-sided in intent: neither
/// can see the other's profile or published trips, and any follows in either
/// direction are removed when it is created.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Someone flagging content for the person who runs Roava to look at.
///
/// The reporter is optional so a signed-out visitor looking at a published
/// trip can still report it, and nothing about a report is visible to the
/// person being reported.
model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  targetUserId String?
  tripId       String?
  /// A short reason chosen from a list, not free text
  reason       String
  note         String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  reporter   User? @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser User? @relation("reported", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([reviewedAt, createdAt])
}

/// A one-way follow. No approval: only trips the owner has explicitly
/// published are ever visible, so following reveals nothing on its own.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// A saved location: a restaurant, a museum, a hotel, a viewpoint.
/// `status` is what powers both the wishlist and the "places I've been" map.
model Place {
  id          String    @id @default(cuid())
  userId      String
  name        String
  /// PlaceCategory value — see src/lib/taxonomy.ts
  category    String    @default("other")
  /// Overrides the category's icon on the map and in lists. Null falls back to
  /// whatever the category uses.
  emoji       String?
  /// "wishlist" (want to go), "visited" (been there) or "lived" (lived there)
  status      String    @default("wishlist")
  /// Only for "lived": when you moved there, and when you left. An open end
  /// means you are still there.
  livedFrom   DateTime?
  livedTo     DateTime?
  lat         Float
  lng         Float
  address     String?
  city        String?
  country     String?
  /// ISO 3166-1 alpha-2, lowercased. Drives the country count on /been.
  countryCode String?
  notes       String?
  /// 1–5, only meaningful once visited
  rating      Int?
  /// A picture of the place, found on Wikipedia rather than taken by anyone
  /// here — somewhere you only want to go has no photo of its own yet.
  photoUrl         String?
  /// Who took it and under what licence. Most are CC BY-SA, which requires
  /// naming the author, so this is shown wherever the photo is.
  photoAttribution String?
  /// The file's page on Commons, where the full licence lives.
  photoSourceUrl   String?
  /// Set when the photograph is one somebody uploaded rather than one
  /// Wikipedia had. Kept so it can be replaced or deleted later; the URL
  /// itself is public, because a place's photograph shows on published trips
  /// and shared links, where the person looking is not signed in to anything.
  photoPathname    String?
  /// When we last went looking. Set even when nothing was found, so a place
  /// with no article is not searched for on every load.
  photoCheckedAt   DateTime?
  website     String?
  visitedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[] @relation("itemFrom")
  arrivals       ItineraryItem[] @relation("itemTo")
  memories       Memory[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, countryCode])
}

/// A trip: a titled container of day-by-day itinerary items.
model Trip {
  id          String    @id @default(cuid())
  userId      String
  title       String
  /// Kept for every trip made before a trip could have more than one, and as
  /// the fallback everything still reads when `destinations` is empty.
  destination String?
  /// Where the trip goes, in order. A fortnight in Switzerland is Lucerne and
  /// Interlaken and Zermatt, and calling that "Switzerland" loses the only
  /// part a place search can use.
  destinations String[] @default([])
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  /// Hex colour used for this trip's pins and accents
  color       String    @default("#0F2D4A")
  /// How many people are going, counting everybody rather than accounts.
  ///
  /// Five families on a trip is five collaborators and nineteen heads, and it
  /// is heads that tickets are sold to. Null means nobody has said — in which
  /// case a per-head price counts once, which is obviously provisional rather
  /// than invented.
  headcount   Int?
  /// ISO 4217, for everything priced on this trip.
  ///
  /// One per trip rather than one per item. A day whose costs are in three
  /// currencies cannot be totalled without exchange rates, and rates are a
  /// live feed, a cache, a staleness policy and an argument about which day's
  /// rate applied — none of which belongs in a trip planner. Somebody
  /// travelling through the eurozone and Switzerland picks one and estimates
  /// the rest, which is what they were doing on paper anyway.
  currency    String    @default("USD")
  /// A photograph chosen for this trip, stored privately like a journal
  /// photo and read back through /api/trips/[id]/cover. Null for the many
  /// trips nobody picks one for — those borrow a photograph of one of their
  /// own stops instead, which is usually a picture of the trip anyway.
  coverPathname String?
  coverType     String?
  /// Null means private. Set when the owner publishes it to their profile,
  /// and doubles as the ordering key for followers' feeds.
  publishedAt DateTime?
  /// When the owner was asked whether to publish this one and said not now.
  ///
  /// Asked at the finish line — a trip whose dates have passed with real
  /// stops on it — because publishing otherwise lives as a switch at the
  /// bottom of a settings sheet, where two people in twenty-four ever found
  /// it. Recorded so the question is asked once: an offer repeated every time
  /// you open a trip is not an offer, it is a nag.
  publishAskedAt DateTime?
  /// Set when this trip was copied from someone else's, for attribution.
  copiedFromId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ItineraryItem[]
  share         TripShare?
  collaborators TripCollaborator[]
  resources     TripResource[]
  wants         TripWant[]
  documents     TripDocument[]
  copiedFrom    Trip?              @relation("copies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies        Trip[]             @relation("copies")
  memories      Memory[]

  @@index([userId])
  @@index([publishedAt])
}

/// Someone the trip owner has invited to edit the itinerary with them.
///
/// Invitations are addressed to an email rather than an account, so you can
/// invite someone who has not signed up yet; `userId` is filled in the first
/// time they open the trip while signed in with that address.
model TripCollaborator {
  id         String    @id @default(cuid())
  tripId     String
  userId     String?
  /// Lowercased, so invitations match regardless of how it was typed.
  email      String
  /// "editor" — the owner is not stored here, they are Trip.userId
  role       String    @default("editor")
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tripId, email])
  @@index([userId])
}

/// A secret link that lets someone read one trip's itinerary without an
/// account. The token *is* the credential, so it is long, random, and can be
/// rotated or revoked. One link per trip: re-sharing rotates the token, which
/// immediately breaks every copy of the old URL.
model TripShare {
  id           String    @id @default(cuid())
  tripId       String    @unique
  token        String    @unique
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

/// Something that happened, written down.
///
/// Hangs off a place, a trip, both or neither: "the summer we lived in Lisbon"
/// belongs to a place, "the night the train broke down" belongs to a trip, and
/// some things belong to no map pin at all. Everything except the text is
/// optional, because a journal that demands metadata does not get written in.
model Memory {
  id         String    @id @default(cuid())
  userId     String
  placeId    String?
  tripId     String?
  title      String?
  body       String
  /// When it happened, which is rarely when it was written.
  happenedOn DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place  Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  photos Photo[]

  @@index([userId, happenedOn])
  @@index([placeId])
  @@index([tripId])
}

/// A photo attached to a journal entry.
///
/// The file lives in Vercel Blob with private access, so it cannot be read by
/// its URL. Only the pathname is stored — the app streams the bytes back
/// through its own route after checking who is asking, which is what makes
/// deleting an entry actually revoke access rather than merely hide it.
model Photo {
  id          String   @id @default(cuid())
  userId      String
  memoryId    String
  /// Blob pathname, not a URL. Private blobs are fetched by pathname.
  pathname    String
  contentType String
  size        Int
  caption     String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
}

/// One entry on one day of a trip.
///
/// Two shapes, distinguished by `kind`:
///   "stop"   — somewhere you were. `placeId` is where, `startTime` is when.
///   "travel" — a journey between two places: a train, a flight, a ferry.
///              `placeId` is where it left from and `toPlaceId` where it
///              arrived, with `startTime`/`endTime` as departure and arrival.
///
/// Both keep placeId optional, so entries the map has never heard of still fit.
model ItineraryItem {
  id        String   @id @default(cuid())
  tripId    String
  /// What this costs, as a whole number of the trip currency's smallest unit
  /// — cents, pence, yen. Never a decimal: a price is a count of indivisible
  /// things, and as a float it produces totals ending in .999999994 that
  /// nobody can explain and everybody notices.
  ///
  /// Null is "nobody has priced this", which is not the same as free. A day
  /// of unpriced stops shows no total rather than a confident zero.
  costMinor Int?
  /// Whether that price is per person or for the whole party.
  ///
  /// The first question anybody asks about a price on a group trip, and not a
  /// rounding error to get wrong: nineteen people and a $120 ticket is $120
  /// or $2,280 depending on the answer. Tickets and meals are each; a villa
  /// is not.
  costEach  Boolean @default(false)
  /// "stop" or "travel"
  kind      String   @default("stop")
  placeId   String?
  /// Only for travel: where the journey ends.
  toPlaceId String?
  /// Only for travel: train, bus, plane, ferry, car, walk
  mode      String?
  title     String
  notes     String?
  /// 0-based day offset from the trip's first day
  dayIndex  Int      @default(0)
  /// "HH:mm", local to the destination. For travel this is the departure, and
  /// travel is the only kind that still asks for it: a flight leaves at 09:40
  /// whatever anybody intended, but nobody plans a museum for 14:30 to 16:15.
  ///
  /// Ordinary stops set this before durations existed, and those values are
  /// still read rather than discarded — a stop entered as 15:30 to 17:30 shows
  /// as "about 2 hours".
  startTime String?
  /// Only for travel: the arrival time, local to where it lands.
  endTime   String?
  /// Only for travel: how many days later it arrives. A flight east across the
  /// Atlantic leaves at seven and lands at eight the next morning, which as two
  /// bare clock times reads as arriving eleven hours before it left.
  ///
  /// Days rather than a timestamp, because that is how the two times are read.
  /// Nobody converts a boarding pass to UTC; they read "out at seven, in at
  /// eight, next morning".
  endDayOffset Int    @default(0)
  /// How long an ordinary stop takes, in minutes.
  ///
  /// A day is a handful of things in an order with a rough sense of how long
  /// each one eats. The moment a plan claims to know that a temple runs 14:30
  /// to 16:15, it is wrong by ten in the morning, and everything after the
  /// first overrun is a lie somebody then has to go and edit.
  minutes   Int?
  category  String   @default("other")
  /// Overrides the icon for this stop only, so a place can look one way on the
  /// map and another on a particular day. Also the only emoji a stop with no
  /// place can have.
  emoji     String?
  /// Sort position within the day
  position  Int      @default(0)
  /// Whether this needs booking, and whether it has been: "needed" or "booked".
  /// Null means nobody has said, which is most things — a walk along the lake
  /// is not a booking, and a trip full of "N/A" rows is noise rather than a
  /// list. Only what someone marked appears on the bookings tab.
  booking   String?
  /// The confirmation number, reference, or whatever else you would need at
  /// the door. Free text: airlines, restaurants and cable cars all disagree
  /// about what a booking reference looks like.
  bookingRef String?
  /// When this has to be booked by, if it has a deadline.
  ///
  /// The spreadsheet this app grew out of carried these as notes — "book 3
  /// days before", "book 1-3 days before" — which is a deadline written where
  /// nothing can act on it. A date can be sorted by, coloured, and reminded
  /// about; a sentence in a notes field can only be re-read.
  ///
  /// Absolute rather than "three days before", because the thing wanting it is
  /// a reminder, and a reminder needs a date. A stop that moves leaves its
  /// deadline behind, which is the honest behaviour: the tour did not change
  /// its cut-off because you rearranged your Tuesday.
  bookBy     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place     Place?           @relation("itemFrom", fields: [placeId], references: [id], onDelete: SetNull)
  toPlace   Place?           @relation("itemTo", fields: [toPlaceId], references: [id], onDelete: SetNull)
  documents TripDocument[]
  arrivals  TravelArrival[]

  @@index([tripId, dayIndex, position])
  @@index([placeId])
  @@index([toPlaceId])
}

/// Who is arriving on a travel leg.
///
/// A trip with more than one family often has several flights landing at
/// different times. Tagging people on the leg, rather than stuffing names into
/// the notes, is what lets everyone on the trip see who lands when.
///
/// Optional: a leg with nobody tagged is still a perfectly good flight. Solo
/// trips never need this; collaborative ones use it when arrivals stagger.
model TravelArrival {
  id        String   @id @default(cuid())
  itemId    String
  /// The person on this arrival. Must be the trip's owner or an accepted
  /// collaborator — free-text names are not stored here.
  userId    String
  createdAt DateTime @default(now())

  item ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
}

/// A file belonging to a trip: the hotel confirmation, the ticket, the
/// itinerary somebody emailed you.
///
/// Stored privately and read back through an authenticated route, the way
/// photos are — a booking confirmation carries a name, a reference and often
/// an address, and a public blob URL would be a way in for anyone who guessed
/// it. Access follows the trip rather than the uploader: whoever can edit the
/// trip can read its confirmations, which is the point of sharing one.
model TripDocument {
  id     String @id @default(cuid())
  tripId String
  /// Whoever uploaded it. A scalar rather than a relation: the file belongs to
  /// the trip, and outliving the person who added it is correct on a shared
  /// one. Deleting an account still removes these, through its trips.
  userId String
  /// Blob pathname, not a URL. Private blobs are fetched by pathname.
  pathname    String
  /// The name it had on their computer, which is how they will look for it.
  name        String
  contentType String
  size        Int
  /// The stop this confirms, when it confirms one. Null for a file that
  /// belongs to the trip at large — the insurance, the packing list.
  ///
  /// Cleared rather than cascaded when the stop goes: removing a hotel from
  /// the plan should not silently destroy the confirmation for the night you
  /// have already paid for. It falls back to the trip's own pile.
  itemId      String?
  createdAt   DateTime @default(now())

  trip Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  item ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([itemId])
}

/// Something you need to have before the trip rather than somewhere you go on
/// it: the transit app that only works if you registered a card at home, the
/// rail pass that is cheaper bought in advance, the offline map, the visa.
///
/// These are the notes that live in a group chat and are lost by the time they
/// matter. Keeping them on the trip means they are read on the way to the
/// airport, which is when they are worth anything.
/// Something one person on a trip wants to do.
///
/// A trip with five families on it has one organiser and nineteen other
/// opinions, and until now there was nowhere to put them: the itinerary is
/// editable by everyone, which sounds like collaboration and works like a
/// scrum. This is the quiet half — say what you would like, see what everyone
/// else said, and let whoever is building the days read the lot.
///
/// Not a TripResource with a kind. Those are checklist rows, answering "have
/// I got this yet"; a want is attributed to a person and answers "what would
/// make this trip worth it for you", which is a different question with a
/// different lifetime — it stops mattering once the day is planned.
model TripWant {
  id     String @id @default(cuid())
  tripId String
  /// Whose it is. The whole point: an unattributed wish list is a suggestion
  /// box, and what an organiser needs to know is who still has not been
  /// listened to.
  userId String
  label  String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model TripResource {
  id       String  @id @default(cuid())
  tripId   String
  label    String
  /// Where to get it — a store page, a booking site, a government form.
  url      String?
  note     String?
  /// "app", "pass", "doc" or "link". Only decides which icon it wears.
  kind     String  @default("app")
  /// Ticked once you actually have it.
  ready    Boolean @default(false)
  position Int     @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

/// The last few sign-in failures, kept so they can be read without dashboard
/// access to the host's logs.
///
/// Auth.js reports almost every server-side failure to the browser as
/// "Configuration", which names the wrong suspect and hides the real one. The
/// actual error exists only in the runtime log, which is exactly where it is
/// hardest to get at when a deployment is misbehaving.
///
/// Nothing here is user data: it is our own exception text. Rows are trimmed
/// to the most recent handful, since this is a diagnostic and not a record.
model AuthError {
  id        String   @id @default(cuid())
  /// The error's class name, e.g. PrismaClientValidationError
  kind      String
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A category somebody made for themselves.
///
/// The ten built-in categories live in code, not here: they are what the
/// geocoder's guesses map onto, they are the same for everyone, and they are
/// what a place falls back to. These sit alongside them.
///
/// A place stores its category as a plain string, which is either one of the
/// built-in ids or the id of one of these. The built-in ids are words and these
/// are cuids, so the two can never collide.
model Category {
  id        String   @id @default(cuid())
  userId    String
  label     String
  /// The emoji shown on the map and in lists.
  icon      String
  /// Hex, and the colour of the pin.
  color     String
  /// Sort position in the picker.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Two categories with the same name would be indistinguishable in a picker.
  @@unique([userId, label])
  @@index([userId, position])
}

/// One person's changes to a built-in category.
///
/// The ten built-ins stay in code because they are what the geocoder's guesses
/// map onto and what anything unrecognised falls back to — that has to mean the
/// same thing for everyone. How they look does not. Somebody who never drinks
/// should not have Bar in their picker, and somebody who thinks Stay deserves a
/// tent rather than a bed should be able to say so.
///
/// A row exists only where somebody has changed something. No row means the
/// built-in, unmodified, which is why every field but `hidden` is nullable:
/// null is "leave this as it was", not "blank".
model CategoryOverride {
  id         String   @id @default(cuid())
  userId     String
  /// The built-in category's id — one of the words, never a cuid.
  categoryId String
  label      String?
  icon       String?
  color      String?
  /// Kept out of the pickers. Places already filed under it still show it:
  /// hiding is about what you are offered, not about rewriting your history.
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

/// Somewhere you have been, handed to somebody who is going there.
///
/// A trip is a plan with days in it. This is the other thing people ask for —
/// "I'm in Charleston next week, where should I eat" — which is a place, a
/// subset of what you know about it, and no dates at all.
///
/// Deliberately live rather than a snapshot: adding a restaurant next month
/// adds it to every link you have already sent. A guide somebody keeps is
/// worth more than a copy that rots, and the alternative is re-sending a link
/// every time you learn something.
model PlaceShare {
  id     String @id @default(cuid())
  userId String
  /// The city or country it covers, matched against a place's own city and
  /// country the same way the map's drill-down does.
  area   String
  /// Which categories are included. Empty means all of them — including any
  /// added after the link was made, which is what "all" should keep meaning.
  categories String[]
  /// Which statuses are included. Recommendations are normally places you have
  /// actually been, not ones you are still hoping to get to, but somebody
  /// sharing a wishlist for a trip they are planning together wants the
  /// opposite.
  statuses String[]
  /// Shown at the top, for the sentence that usually comes with the link.
  note String?

  token        String    @unique
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, area])
}

/// A one-time code handed to the app after signing in on the web.
///
/// The app cannot do Google sign-in itself without a native module, so it opens
/// the website, which already does it, and the website hands the result back
/// through the app's URL scheme.
///
/// What comes back is this code and not the token. A custom scheme is not a
/// private channel — anything on the device can claim to be "roava://" — so the
/// thing that travels through it is useless on its own: single use, ninety
/// seconds, and redeemed over HTTPS for the real token. A stolen code is a race
/// rather than an account.
model NativeAuthCode {
  code      String   @id
  userId    String
  /// Sent by the app when it started, and required again when redeeming, so a
  /// code cannot be fed to an app that did not ask for one.
  state     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One itinerary drafted by the model, recorded because it cost money.
///
/// Every generation is a paid API call, so without a record there is no way to
/// cap anybody, no way to see what a person is spending, and no way to tell a
/// free allowance from a paid one when there is something to sell. Kept small:
/// what was asked for, what it cost in tokens, and when.
model AiDraft {
  id     String @id @default(cuid())
  userId String

  destination String
  days        Int
  /// What came back, so a draft survives a closed tab and can be looked at
  /// again without paying twice.
  itinerary   String
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  /// Of the input, how much was served from cache rather than charged at full
  /// price. Recorded so the saving can be checked rather than assumed — a
  /// column of zeroes means the caching is not working.
  cachedTokens Int @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
